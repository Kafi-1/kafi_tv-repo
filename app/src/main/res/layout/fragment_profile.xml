<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:maxWidth="540dp"
        android:layout_gravity="center_horizontal">

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="32dp"
            android:gravity="center">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar" />
                <TextView
                    android:id="@+id/tvAvatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="U"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_hint"
                android:layout_marginTop="4dp" />

            <!-- Info Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <!-- PIN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_row"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/label_pin_access" android:textColor="@color/text_secondary" android:textSize="@dimen/text_md" />
                    <TextView android:id="@+id/tvProfilePin" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/primary" android:textStyle="bold" android:textSize="@dimen/text_md" />
                </LinearLayout>

                <!-- Join Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_row"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/label_join_date" android:textColor="@color/text_secondary" android:textSize="@dimen/text_md" />
                    <TextView android:id="@+id/tvProfileStart" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/accent_green" android:textStyle="bold" android:textSize="@dimen/text_md" />
                </LinearLayout>

                <!-- Expiry Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_row"
                    android:padding="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/label_expiry_date" android:textColor="@color/text_secondary" android:textSize="@dimen/text_md" />
                    <TextView android:id="@+id/tvProfileExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/status_expired" android:textStyle="bold" android:textSize="@dimen/text_md" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Payment Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/renew_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue" />

            <TextView
                android:id="@+id/tvMonthlyPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_hint"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- bKash Number -->
            <LinearLayout
                android:id="@+id/layoutBkash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_row"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/bkash_label" android:textColor="@color/text_secondary" android:textSize="@dimen/text_sm" android:textStyle="bold" />
                <TextView android:id="@+id/tvBkashNum" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/primary" android:textStyle="bold" android:textSize="@dimen/text_md" />
            </LinearLayout>

            <!-- Nagad Number -->
            <LinearLayout
                android:id="@+id/layoutNagad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_row"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/nagad_label" android:textColor="@color/text_secondary" android:textSize="@dimen/text_sm" android:textStyle="bold" />
                <TextView android:id="@+id/tvNagadNum" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/primary" android:textStyle="bold" android:textSize="@dimen/text_md" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPayNumber"
                style="@style/InputField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_bkash_nagad"
                android:inputType="phone"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <EditText
                android:id="@+id/etPayTrx"
                style="@style/InputField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_trx_id"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <Button
                android:id="@+id/btnSubmitPayment"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_submit_request"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
