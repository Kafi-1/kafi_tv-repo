<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <!-- Background gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="40dp"
            android:maxWidth="420dp"
            android:layout_gravity="center">

            <!-- App Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:letterSpacing="-0.05" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp" />

            <!-- User ID Input -->
            <EditText
                android:id="@+id/etUserId"
                style="@style/InputField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_user_id"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etPin"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- PIN Input -->
            <EditText
                android:id="@+id/etPin"
                style="@style/InputField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_pin"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:gravity="center"
                android:letterSpacing="0.5"
                android:imeOptions="actionDone"
                android:nextFocusDown="@id/btnLogin"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Login Button -->
            <Button
                android:id="@+id/btnLogin"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/btn_start_streaming"
                android:focusable="true" />

            <!-- Error Message -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/error_invalid_credentials"
                android:textColor="@color/text_error"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
